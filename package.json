{
  "name": "latex-code-generator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "frontend": "npm run start --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/multer": "^2.0.0",
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  }
}
